# Used by `docker compose up`.
TZ=UTC
MQTT_USER=
MQTT_PASSWORD=
# The SLZB-06M's IP address. Zigbee2MQTT restarts in a loop until it's set.
SLZB_HOST=
# On a Mac, Home Assistant needs bridge. On a server, remove this line to use host networking.
HA_NETWORK_MODE=bridge
# A long-lived token for the dashboard, from your Home Assistant profile, under
# Security > Long-lived access tokens. Prefer a non-admin user.
DASHBOARD_HA_TOKEN=

# Used by `pnpm dev`. `pnpm ha:setup` writes these for the demo Home Assistant. To use your
# real one instead, set HA_URL=http://localhost:8123 and your token as HA_TOKEN.
HA_URL=http://localhost:8124
HA_TOKEN=

# Optional. These are the defaults.
# PORT=3000
# DB_PATH=data/dashboard.db
# HA_PORT=8124
# DASHBOARD_PORT=3000
