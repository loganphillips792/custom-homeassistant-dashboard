# `pnpm ha:setup` writes HA_URL and HA_TOKEN for the development Home Assistant.
# To use a real instance instead, set them yourself. Prefer a non-admin user's token,
# created under Profile > Security > Long-lived access tokens.
HA_URL=http://localhost:8124
HA_TOKEN=

# Optional. These are the defaults.
# PORT=3000
# DB_PATH=data/dashboard.db
# HA_PORT=8124
# DASHBOARD_PORT=3000
