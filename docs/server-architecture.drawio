<mxfile host="app.diagrams.net">
  <diagram id="server-architecture" name="Server architecture">
    <mxGraphModel adaptiveColors="auto">
      <root>
        <mxCell id="0"/>
        <mxCell id="1" parent="0"/>
        <mxCell id="title" value="Dashboard Server Architecture" style="text;html=1;fontSize=20;fontStyle=1;align=center;verticalAlign=middle;strokeColor=none;fillColor=none;" vertex="1" parent="1">
          <mxGeometry x="220" y="0" width="400" height="36" as="geometry"/>
        </mxCell>
        <mxCell id="browser" value="Browser&lt;br&gt;&lt;small&gt;React dashboard (web/)&lt;/small&gt;" style="rounded=1;whiteSpace=wrap;html=1;fontSize=14;fillColor=#dae8fc;strokeColor=#6c8ebf;" vertex="1" parent="1">
          <mxGeometry x="270" y="50" width="300" height="60" as="geometry"/>
        </mxCell>
        <mxCell id="server" value="Dashboard server · Node.js, port 3000" style="swimlane;startSize=30;html=1;fontSize=14;align=left;spacingLeft=10;fillColor=#f5f5f5;strokeColor=#666666;" vertex="1" parent="1">
          <mxGeometry x="40" y="190" width="760" height="270" as="geometry"/>
        </mxCell>
        <mxCell id="app" value="Hono HTTP app (app.ts)&lt;br&gt;&lt;small&gt;/api/dashboard · /api/entities/:id/toggle · /api/events · /api/health · static web/dist&lt;/small&gt;" style="rounded=1;whiteSpace=wrap;html=1;fontSize=14;fillColor=#dae8fc;strokeColor=#6c8ebf;" vertex="1" parent="server">
          <mxGeometry x="20" y="45" width="720" height="60" as="geometry"/>
        </mxCell>
        <mxCell id="store" value="Dashboard store&lt;br&gt;&lt;small&gt;db.ts&lt;/small&gt;" style="rounded=1;whiteSpace=wrap;html=1;fontSize=14;fillColor=#dae8fc;strokeColor=#6c8ebf;" vertex="1" parent="server">
          <mxGeometry x="20" y="190" width="180" height="60" as="geometry"/>
        </mxCell>
        <mxCell id="hub" value="Entity hub&lt;br&gt;&lt;small&gt;entityHub.ts · latest states&lt;/small&gt;" style="rounded=1;whiteSpace=wrap;html=1;fontSize=14;fillColor=#dae8fc;strokeColor=#6c8ebf;" vertex="1" parent="server">
          <mxGeometry x="290" y="190" width="180" height="60" as="geometry"/>
        </mxCell>
        <mxCell id="haclient" value="HA client&lt;br&gt;&lt;small&gt;connection.ts&lt;/small&gt;" style="rounded=1;whiteSpace=wrap;html=1;fontSize=14;fillColor=#dae8fc;strokeColor=#6c8ebf;" vertex="1" parent="server">
          <mxGeometry x="560" y="190" width="180" height="60" as="geometry"/>
        </mxCell>
        <mxCell id="sqlite" value="SQLite&lt;br&gt;&lt;small&gt;dashboard.db&lt;/small&gt;" style="shape=cylinder3;whiteSpace=wrap;html=1;fontSize=14;boundedLbl=1;size=10;fillColor=#d5e8d4;strokeColor=#82b366;" vertex="1" parent="1">
          <mxGeometry x="80" y="530" width="140" height="80" as="geometry"/>
        </mxCell>
        <mxCell id="ha" value="Home Assistant&lt;br&gt;&lt;small&gt;HA_URL · long-lived token&lt;/small&gt;" style="rounded=1;whiteSpace=wrap;html=1;fontSize=14;fillColor=#ffe6cc;strokeColor=#d79b00;" vertex="1" parent="1">
          <mxGeometry x="590" y="540" width="200" height="60" as="geometry"/>
        </mxCell>
        <mxCell id="legend" value="Solid: request or call&lt;br&gt;Dashed: pushed updates" style="text;html=1;fontSize=12;align=center;verticalAlign=middle;strokeColor=none;fillColor=none;" vertex="1" parent="1">
          <mxGeometry x="310" y="545" width="200" height="50" as="geometry"/>
        </mxCell>
        <mxCell id="e1" value="REST" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;exitX=0.25;exitY=1;entryX=0.396;entryY=0;labelBackgroundColor=default;defaultLabelBackgroundColor=page;labelPlacement=auto;" edge="1" parent="1" source="browser" target="app">
          <mxGeometry relative="1" as="geometry"/>
        </mxCell>
        <mxCell id="e2" value="SSE" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;dashed=1;exitX=0.604;exitY=0;entryX=0.75;entryY=1;labelBackgroundColor=default;defaultLabelBackgroundColor=page;labelPlacement=auto;" edge="1" parent="1" source="app" target="browser">
          <mxGeometry relative="1" as="geometry"/>
        </mxCell>
        <mxCell id="e3" value="load / save" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;exitX=0.125;exitY=1;entryX=0.5;entryY=0;labelBackgroundColor=default;defaultLabelBackgroundColor=page;labelPlacement=auto;" edge="1" parent="server" source="app" target="store">
          <mxGeometry relative="1" as="geometry"/>
        </mxCell>
        <mxCell id="e4" value="events" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;dashed=1;exitX=0.5;exitY=0;entryX=0.5;entryY=1;labelBackgroundColor=default;defaultLabelBackgroundColor=page;labelPlacement=auto;" edge="1" parent="server" source="hub" target="app">
          <mxGeometry relative="1" as="geometry"/>
        </mxCell>
        <mxCell id="e5" value="toggle" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;exitX=0.875;exitY=1;entryX=0.5;entryY=0;labelBackgroundColor=default;defaultLabelBackgroundColor=page;labelPlacement=auto;" edge="1" parent="server" source="app" target="haclient">
          <mxGeometry relative="1" as="geometry"/>
        </mxCell>
        <mxCell id="e6" value="updates" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;dashed=1;labelBackgroundColor=default;defaultLabelBackgroundColor=page;verticalAlign=bottom;labelPlacement=auto;" edge="1" parent="server" source="haclient" target="hub">
          <mxGeometry relative="1" as="geometry"/>
        </mxCell>
        <mxCell id="e7" value="SQL" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;labelBackgroundColor=default;defaultLabelBackgroundColor=page;labelPlacement=auto;" edge="1" parent="1" source="store" target="sqlite">
          <mxGeometry relative="1" as="geometry"/>
        </mxCell>
        <mxCell id="e8" value="WebSocket" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;startArrow=classic;labelBackgroundColor=default;defaultLabelBackgroundColor=page;labelPlacement=auto;" edge="1" parent="1" source="haclient" target="ha">
          <mxGeometry relative="1" as="geometry"/>
        </mxCell>
      </root>
    </mxGraphModel>
  </diagram>
</mxfile>
